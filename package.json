{
  "name": "@aiand/cli",
  "version": "0.1.2",
  "description": "Command line interface for the ai& API.",
  "license": "Apache-2.0",
  "author": "ai&",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiandlabs/aiand-cli.git"
  },
  "homepage": "https://docs.aiand.com",
  "bugs": {
    "url": "https://github.com/aiandlabs/aiand-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "aiand",
    "ai&",
    "cli",
    "openai-compatible",
    "llm",
    "inference"
  ],
  "type": "module",
  "bin": {
    "aiand": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:dist": "node scripts/check-dist.mjs",
    "check:public": "node scripts/check-public.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
