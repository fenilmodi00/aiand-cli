{
  "name": "@aiand/cli",
  "version": "0.4.0",
  "description": "Command line interface for the ai& API.",
  "license": "Apache-2.0",
  "author": "ai&",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiandlabs/aiand-cli.git"
  },
  "homepage": "https://docs.aiand.com",
  "bugs": {
    "url": "https://github.com/aiandlabs/aiand-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "aiand",
    "ai&",
    "cli",
    "openai-compatible",
    "llm",
    "inference"
  ],
  "type": "module",
  "bin": {
    "aiand": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "npm run build && biome check . && knip",
    "fix": "biome check --write .",
    "check:dist": "node scripts/check-dist.mjs",
    "check:public": "node scripts/check-public.mjs",
    "release": "node scripts/release.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:coverage": "npm run build && node --import ./test/setup.mjs --test --experimental-test-coverage --test-coverage-include=\"dist/**\" --test-coverage-lines=89 --test-coverage-branches=84 --test-coverage-functions=91 test/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "knip": "6.38.0",
    "typescript": "7.0.2"
  }
}
