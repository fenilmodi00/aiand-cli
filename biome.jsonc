{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // A terminal CLI matches ANSI escapes and control bytes on purpose
        // (OSC 8 links, stripping styles, node:test frame detection).
        "noControlCharactersInRegex": "off"
      },
      "style": {
        // `!` here follows noUncheckedIndexedAccess checks tsc already enforces.
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // Biome 2.6 formats Markdown by default. Its rewrites change meaning (front
  // matter, wrapped lines that start with +), so the docs keep their own layout.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
