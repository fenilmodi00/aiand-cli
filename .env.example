# --- Required: ai& gateway -----------------------------------------------
# Per-process key, never stored. Takes precedence over `aiand login` session.
AIAND_API_KEY=sk-your-key-here
# API endpoint default. Override both base URLs.
AIAND_BASE_URL=https://api.aiand.com
# Override the sign-in base URL only (defaults to AIAND_BASE_URL).
# AIAND_AUTH_URL=https://api.aiand.com

# --- Profiles and paths ---------------------------------------------------
# Profile to use (default: default).
# AIAND_PROFILE=default
# Where config.json / credentials.json live (default: ~/.config/aiand).
# AIAND_CONFIG_DIR=/home/YOU/.config/aiand
# Home dir agents resolve their config from (default: $HOME).
# AIAND_HOME=/home/YOU

# --- Secret storage -------------------------------------------------------
# Force the secret tier: keychain, file, or plaintext (plaintext = CI/tests only).
# AIAND_KEY_STORAGE=file
# 64 hex chars (32 bytes); overrides the encrypted-file master key.
# AIAND_SECRET_STORE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Update checks --------------------------------------------------------
# Set to 0 to disable the update notice (also: NO_UPDATE_CHECK=1, or CI set).
# AIAND_UPDATE_CHECK=1

# --- Agent / harness homes (optional) -------------------------------------
# DeepSeek harness config root (default: ~/.dsh).
# DSH_HOME=/home/YOU/.dsh
# A stray ANTHROPIC_API_KEY is pre-approved in ~/.claude.json so Claude Code
# skips its one-time custom-key prompt; it never bypasses the gateway session.
# ANTHROPIC_API_KEY=
